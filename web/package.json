    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "geotiff": "3.0.5",
    "hyparquet": "1.31.3",
    "hyparquet-compressors": "1.1.2",
    "leaflet": "1.9.4",
    "zstddec": "0.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
